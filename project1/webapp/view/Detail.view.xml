<mvc:View
    controllerName="project1.controller.Detail"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form">
    <uxap:ObjectPageLayout
        id="objectPage"
        showTitleInHeaderContent="true"
        upperCaseAnchorBar="false">
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <Title
                        id="productTitle"
                        text="{odataV2Model>Name}"
                        wrapping="true"/>
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <Title
                        text="{odataV2Model>Name}"
                        wrapping="true"/>
                </uxap:snappedHeading>
                <uxap:actions>
                    <Button
                        id="editButton"
                        text="{i18n>edit}"
                        type="Emphasized"
                        press=".onEdit"
                        visible="{= !${view>/editMode} &amp;&amp; !${view>/createMode}}"/>
                    <Button
                        id="deleteButton"
                        text="{i18n>delete}"
                        press=".onDelete"
                        visible="{= !${view>/editMode} &amp;&amp; !${view>/createMode}}"/>
                    <Button
                        id="saveButton"
                        text="{i18n>save}"
                        type="Emphasized"
                        press=".onSave"
                        visible="{= ${view>/editMode} || ${view>/createMode}}"/>
                    <Button
                        id="cancelButton"
                        text="{i18n>cancel}"
                        press=".onCancel"
                        visible="{= ${view>/editMode} || ${view>/createMode}}"/>
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <uxap:headerContent>
            <layout:HorizontalLayout>
                <layout:VerticalLayout class="sapUiSmallMarginEnd">
                    <ObjectAttribute
                        title="{i18n>price}"
                        text="${odataV2Model>Price}"/>
                    <ObjectAttribute
                        title="{i18n>rating}"
                        text="{odataV2Model>Rating}"/>
                </layout:VerticalLayout>
                <layout:VerticalLayout>
                    <ObjectAttribute
                        title="{i18n>releaseDate}"
                        text="{
                            path: 'odataV2Model>ReleaseDate',
                            type: 'sap.ui.model.type.Date',
                            formatOptions: { pattern: 'dd/MM/yyyy' }
                        }"/>
                </layout:VerticalLayout>
            </layout:HorizontalLayout>
        </uxap:headerContent>
        <uxap:sections>
            <uxap:ObjectPageSection
                title="{i18n>generalInformation}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <form:SimpleForm
                                id="productForm"
                                editable="true"
                                layout="ResponsiveGridLayout">
                                <form:content>
                                    <Label text="{i18n>productName}"/>
                                    <Input
                                        id="nameInput"
                                        value="{odataV2Model>Name}"
                                        editable="{= ${view>/editMode} || ${view>/createMode}}"/>
                                    <Label text="{i18n>description}"/>
                                    <TextArea
                                        id="descriptionInput"
                                        value="{odataV2Model>Description}"
                                        rows="3"
                                        editable="{= ${view>/editMode} || ${view>/createMode}}"/>
                                    <Label text="{i18n>price}"/>
                                    <Input
                                        id="priceInput"
                                        value="{odataV2Model>Price}"
                                        type="Number"
                                        editable="{= ${view>/editMode} || ${view>/createMode}}"/>
                                    <Label text="{i18n>rating}"/>
                                    <StepInput
                                        id="ratingInput"
                                        value="{odataV2Model>Rating}"
                                        min="1"
                                        max="5"
                                        step="1"
                                        editable="{= ${view>/editMode} || ${view>/createMode}}"/>
                                    <Label text="{i18n>releaseDate}"/>
                                    <DatePicker
                                        id="releaseDatePicker"
                                        value="{
                                            path: 'odataV2Model>ReleaseDate',
                                            type: 'sap.ui.model.type.Date',
                                            formatOptions: { pattern: 'dd/MM/yyyy' }
                                        }"
                                        editable="{= ${view>/editMode} || ${view>/createMode}}"/>
                                </form:content>
                            </form:SimpleForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>