<mvc:View
	controllerName="project1.controller.Detail"
	xmlns="sap.uxap"
	xmlns:m="sap.m"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:mvc="sap.ui.core.mvc">
	<ObjectPageLayout
		id="ObjectPageLayout"
		showTitleInHeaderContent="true"
		alwaysShowContentHeader="false"
		preserveHeaderStateOnScroll="false"
		headerContentPinnable="true"
		isChildPage="true"
		upperCaseAnchorBar="false">
        <headerTitle>
			<ObjectPageDynamicHeaderTitle>
                <expandedHeading>
					<m:Title text="{edit>/Name}" wrapping="true" class="sapUiSmallMarginEnd"/>
				</expandedHeading>
				<actions>
					<m:ToggleButton
						text="{i18n>edit}"
						type="Emphasized"
						pressed="{= ${view>/editMode} }"
					    enabled="{= !${view>/editMode} }"
						visible="{= !${view>/createMode} }"
                        press=".onEdit"/>
					<m:Button
						text="{i18n>delete}"
						type="Transparent"
						visible="{= !${view>/createMode} }"
                        press=".onDelete"/>
				</actions>
			</ObjectPageDynamicHeaderTitle>
		</headerTitle>
        <headerContent>
			<m:FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">
				<m:Avatar
					displaySize="L"
					displayShape="Square"
					class="sapUiTinyMarginEnd">
				</m:Avatar>
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="{i18n>name}"/>
                    <m:Text text="{edit>/Name}"/>
				</m:VBox>
				<m:VBox justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label text="{i18n>price}"/>
                    <m:Text text="{edit>/Price}"/>
				</m:VBox>
			</m:FlexBox>
		</headerContent>
        <sections>
			<ObjectPageSection title="General Information">
				<subSections>
					<ObjectPageSubSection>
						<blocks>
							<form:SimpleForm
                                id="productForm"
								maxContainerCols="2"
                                editable="{view>/editMode}"
								layout="ResponsiveGridLayout"
								labelSpanL="12"
								labelSpanM="12"
								emptySpanL="0"
								emptySpanM="0"
								columnsL="1"
								columnsM="1">
								<form:content>
									<m:Label text="{i18n>productId}"/>
                                    <m:Text text="{edit>/ID}"/>

                                    <m:Label text="{i18n>name}"/>
                                    <m:Input value="{edit>/Name}" enabled="{view>/editMode}"/>

                                    <m:Label text="{i18n>description}"/>
                                    <m:Input value="{edit>/Description}" enabled="{view>/editMode}"/>

                                    <m:Label text="{i18n>releaseDate}"/>
                                    <m:DatePicker
										id="productDatePicker"
										value="{
											path: 'edit>/ReleaseDate',
											type:'sap.ui.model.type.Date',
											formatOptions:{
													pattern:'dd/MM/yyyy',
													strictParsing: true
												}
											}"
                                        enabled="{view>/editMode}"/>
                                    <m:Label text="{i18n>rating}"/>

                                    <m:RatingIndicator
                                        value="{edit>/Rating}"
                                        maxValue="5"
                                        enabled="{view>/editMode}"/>

                                    <m:Label text="{i18n>price}"/>
                                    <m:Input value="{edit>/Price}" enabled="{view>/editMode}"/>
								</form:content>
							</form:SimpleForm>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
        </sections>
        <footer>
			<m:OverflowToolbar>
				<m:ToolbarSpacer/>
				<m:Button type="Accept" text="{i18n>save}" press=".onSave"/>
				<m:Button type="Reject" text="{i18n>cancel}" press=".onCancel"/>
			</m:OverflowToolbar>
		</footer>
	</ObjectPageLayout>
</mvc:View>